# Mercado Pago Checkout Pro (Preferences API) — usar exclusivamente credenciales TEST.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_WEBHOOK_SECRET=

# URLs públicas HTTPS requeridas por Mercado Pago para notificaciones y retornos.
# Para desarrollo local, usar un túnel HTTPS público (por ejemplo, una URL temporal).
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_RETURN_BASE_URL=

# El catálogo está expresado en USD. Configurar un tipo de cambio USD -> PEN
# aprobado por el negocio antes de habilitar el checkout.
MERCADOPAGO_USD_PEN_RATE=
MERCADOPAGO_RESERVATION_MINUTES=30
