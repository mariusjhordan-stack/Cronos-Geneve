# Django production settings (leave DATABASE_URL empty for local SQLite development).
DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DATABASE_URL=

# Public origins used when the frontend and API are deployed as separate services.
FRONTEND_URL=
BACKEND_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Mercado Pago Checkout Pro (Preferences API) — usar exclusivamente credenciales TEST.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_WEBHOOK_SECRET=

# Compatibilidad local: URL pública común para retorno y webhook cuando no hay dominios separados.
PUBLIC_BASE_URL=

# En despliegue separado: retorno apunta a React y webhook a Django.
MERCADOPAGO_RETURN_BASE_URL=
MERCADOPAGO_WEBHOOK_URL=

# El catálogo está expresado en USD. Configurar un tipo de cambio USD -> PEN
# aprobado por el negocio antes de habilitar el checkout.
MERCADOPAGO_USD_PEN_RATE=3.75
MERCADOPAGO_RESERVATION_MINUTES=30
